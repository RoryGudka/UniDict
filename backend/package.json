{
  "name": "my-express-ws-server",
  "version": "1.0.0",
  "type": "module",
  "description": "A TypeScript Express.js server with WebSocket support",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "auto-deploy": "node auto-deploy.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.767.0",
    "aws-jwt-verify": "^5.0.0",
    "aws-sdk": "^2.1692.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "https": "^1.0.0",
    "nanoid": "^5.0.9",
    "openai": "^4.28.0",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.19.2",
    "ws": "^8.13.0",
    "wscat": "^6.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/ws": "^8.5.5",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
